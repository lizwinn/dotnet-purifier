<!--
  A self-contained executable for linux-x64, which publishes with the .NET
  runtime pack of that platform, and takes packages from a second feed and
  from a folder feed in the build's tree.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>standalone</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Example.Local" Version="1.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
